{
  "permission": "allow",
  "formatter": true,
  "agent": {
    "build": {
      "compaction": {}
    },
    "plan": {
      "compaction": {}
    },
    "explore": {
      "mode": "subagent",
      "model": "openai/gpt-5.6-luna",
      "options": {
        "reasoningEffort": "medium"
      }
    }
  },
  "lsp": {
    "typescript-frontend": {
      "command": [
        "bash",
        "-c",
        "cd frontend && exec ./node_modules/.bin/typescript-language-server --stdio"
      ],
      "extensions": [".ts", ".tsx", ".js", ".jsx", ".mjs", ".cjs"]
    },

    "eslint-frontend": {
      "command": [
        "bash",
        "-c",
        "cd frontend && exec ./node_modules/.bin/vscode-eslint-language-server --stdio"
      ],
      "extensions": [".ts", ".tsx", ".js", ".jsx", ".mjs", ".cjs"]
    },

    "pyright-backend": {
      "command": [
        "bash",
        "-c",
        "cd backend && exec ../frontend/node_modules/.bin/pyright-langserver --stdio"
      ],
      "extensions": [".py", ".pyi"]
    },

    "typescript": {
      "disabled": true
    },
    "eslint": {
      "disabled": true
    },
    "pyright": {
      "disabled": true
    },
    "deno": {
      "disabled": true
    }
  },
  "mcp": {
    "agentis": {
      "type": "remote",
      "url": "https://agentis.cz/mcp"
    },
    "ask-question": {
      "command": [
        "/var/www/agentis-sdk/.venv/bin/python",
        "-m",
        "agentis_sdk.mcp_server"
      ],
      "cwd": "/var/www/agentis-sdk",
      "type": "local",
      "environment": {
        "PYTHONPATH": "/var/www/agentis-sdk",
        "AGENTIS_API_URL": "https://agentis.cz/api",
        "AGENTIS_API_TOKEN": "{env:AGENTIS_TOKEN}"
      }
    }
  },
  "$schema": "https://opencode.ai/config.json",
  "small_model": "openrouter/openai/gpt-4.1-mini",
  "experimental": {
    "mcp_timeout": 1800000
  },
  "provider": {
    "openai": {
      "models": {
        "gpt-5.6-sol": {
          "options": {
            "reasoningEffort": "medium",
            "textVerbosity": "medium",
            "reasoningSummary": "detailed"
          }
        },
        "gpt-5.6-terra": {
          "options": {
            "reasoningEffort": "high",
            "textVerbosity": "medium",
            "reasoningSummary": "detailed"
          }
        },
        "gpt-5.6-luna": {
          "options": {
            "reasoningEffort": "high",
            "textVerbosity": "medium",
            "reasoningSummary": "detailed"
          }
        }
      }
    },
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio (local)",
      "options": {
        "baseURL": "http://10.0.0.232:1234/v1",
        "apiKey": "not-needed"
      },
      "models": {
        "google/gemma-4-26b-a4b": {
          "name": "google/gemma-4-26b-a4b"
        },
        "google/gemma-4-e4b": {
          "name": "google/gemma-4-e4b"
        }
      }
    }
  }
}
