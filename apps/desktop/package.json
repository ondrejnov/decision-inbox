{
  "name": "@decision-inbox/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Fast desktop inbox for Agentis questions and approvals",
  "author": {
    "name": "Agentis",
    "email": "support@agentis.cz"
  },
  "homepage": "https://agentis.cz",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "concurrently -k \"vite --config vite.config.ts --host 127.0.0.1\" \"npm:watch-main\"",
    "watch-main": "tsc -p tsconfig.main.json --watch",
    "start": "electron .",
    "build": "tsc -p tsconfig.main.json && vite build --config vite.config.ts",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "pretest": "npm run build --workspace @decision-inbox/contracts",
    "test": "vitest run",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb",
    "dist:windows": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "@decision-inbox/contracts": "0.1.0",
    "@phosphor-icons/react": "^2.1.7",
    "@tanstack/react-query": "^5.74.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.5",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "43.3.0",
    "electron-builder": "^26.0.12",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.5",
    "vite": "^6.3.3"
  },
  "build": {
    "appId": "com.agentis.decision-inbox",
    "productName": "Decision Inbox",
    "executableName": "decision-inbox",
    "artifactName": "decision-inbox-${version}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "linux": {
      "category": "Utility",
      "maintainer": "Agentis <support@agentis.cz>",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  }
}
